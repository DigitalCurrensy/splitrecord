#!/bin/sh
# Refuse a private key, a token, or an env file. Outside CI, run the repo check.
set -eu

ci=0
if [ "${1:-}" = "--ci" ]; then
  ci=1
fi

if [ "$ci" -eq 1 ]; then
  files=$(git ls-files)
else
  files=$(git diff --cached --name-only --diff-filter=ACMR)
fi

fail=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  base=$(basename "$f")
  case "$base" in
    .env|.env.*)
      case "$base" in
        .env.example) ;;
        *)
          echo "refused: $f" >&2
          fail=1
          continue
          ;;
      esac
      ;;
  esac
  case "$base" in
    id_rsa|id_ed25519|id_ecdsa)
      echo "refused: $f" >&2
      fail=1
      continue
      ;;
  esac
  case "$f" in
    *.pem|*.p12|*.pfx)
      case "$f" in
        *.pub.pem) ;;
        *)
          echo "refused: $f" >&2
          fail=1
          continue
          ;;
      esac
      ;;
  esac
  if [ -f "$f" ] && grep -E -q \
    -e 'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY' \
    -e 'ghp''_[A-Za-z0-9]' \
    -e 'github_pat''_[A-Za-z0-9]' \
    -e 'sk_''live_' \
    -e 'AKIA''[0-9A-Z]{16}' \
    "$f"
  then
    echo "refused: $f" >&2
    fail=1
  fi
done <<EOF
$files
EOF

if [ "$fail" -ne 0 ]; then
  exit 1
fi

if [ "$ci" -eq 1 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if [ -f tests/test_kernel.py ]; then
  if command -v python3 >/dev/null 2>&1; then
    py=python3
  else
    py=python
  fi
  PYTHONPATH=src "$py" -m unittest tests.test_kernel
  exit 0
fi

for n in splitrecord feasfront dosepath fitslip pinfault rimkeep baghold tubewalk archhold; do
  grep -q "$n" README.md
done
